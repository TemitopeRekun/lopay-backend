# LoPay backend environment.
# Mirrors the Joi validation schema in src/app.module.ts — the app refuses to
# boot if a required var is missing or a placeholder. Copy to `.env` and fill in.

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | production | test
PORT=3001

# ── Encryption (PII at rest) ────────────────────────────────────────────────
# Exactly 64 hex chars (32 bytes). REQUIRED in production; optional in dev
# (unset -> plaintext fallback). Read directly by src/main.ts (initEncryptionKey).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/lopaydb?schema=public"
# Per-instance pg pool ceiling (optional, default 10). Size so N app instances
# stay within Postgres' max_connections; small + pgbouncer when pooled.
DATABASE_POOL_MAX=10
# Optional: PEM contents of the DB server's CA. When set (production), the
# connection verifies the cert (rejectUnauthorized) and pins this CA. Read
# directly by src/prisma/prisma.service.ts (not Joi-validated).
# DATABASE_CA_CERT=
# DB TLS control (optional). 'disable' skips SSL — ONLY for a same-host/private-
# network Postgres that doesn't offer TLS. 'require' forces SSL even outside
# production — use when a dev/staging app points at a managed DB (Supabase/Neon).
# Unset = SSL on in production, off otherwise.
# DATABASE_SSL=require

# ── Auth: Better Auth (replaces the old Firebase-Auth + backend JWT) ────────
BETTER_AUTH_SECRET="replace-with-a-strong-secret-min-32-chars"
BETTER_AUTH_URL="http://localhost:3001"
# Google OAuth (web first; Android client id optional until native Google ships)
GOOGLE_WEB_CLIENT_ID=""
GOOGLE_WEB_CLIENT_SECRET=""
GOOGLE_ANDROID_CLIENT_ID=""

# ── Firebase Admin SDK (FCM push notifications only; NOT auth, NOT storage) ──
# Receipts use Supabase Storage (below); Firebase is only for FCM push.
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Supabase Storage (receipt upload/download signed URLs) ──────────────────
# Server-side service-role credentials. Optional: when URL/key are unset, receipt
# storage is disabled and /health reports storage degraded (the app still boots).
SUPABASE_URL="https://your-project-ref.supabase.co"
# Service-role key (Supabase dashboard → Project Settings → API → service_role).
# SECRET — server only; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Storage bucket name (create it in the Supabase dashboard). Default: receipts
SUPABASE_STORAGE_BUCKET="receipts"
# Optional: download signed-URL lifetime (seconds, 60–86400; default 600).
SUPABASE_SIGNED_URL_TTL_SECONDS=600
# Optional: max receipt upload size in bytes (min 1024; also cap it on the bucket).
# SUPABASE_MAX_UPLOAD_BYTES=5242880

# ── Paystack (split payments: first-payment collection + settlement) ────────
# sk_test_… in dev/test; a real sk_live_… is REQUIRED in production.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: comma-separated allowlist of Paystack webhook source IPs.
# 52.31.139.75,52.49.173.169,52.214.14.220
PAYSTACK_WEBHOOK_ALLOWED_IPS=""
# Optional: where Paystack redirects after payment (web fallback; the inline
# popup doesn't need it).
PAYSTACK_CALLBACK_URL="http://localhost:5173/payment-complete"
# Optional: VAT charged ON TOP of the Paystack processing fee (Nigeria: 7.5%).
# Used to gross up the amount charged so the platform's 2.5% is not eroded by the
# provider fee. Set to 0 if your Paystack pricing is quoted VAT-inclusive — watch
# the `lopay_paystack_fee_delta_kobo` gauge to confirm which applies to you.
PAYSTACK_FEE_VAT_RATE=0.075

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowlist. REQUIRED (non-empty) in production; optional locally
# where the dev origin is reflected. Example:
# https://app.example.com,https://admin.example.com
#
# Web origins only. The mobile apps have no domain — Android reports
# https://localhost and iOS capacitor://localhost — and common/cors-origins.ts
# joins those in for every environment, so you never need to list them here.
CORS_ORIGINS=""

# Origin of the web client. Used to build the absolute URL a WEB push
# notification opens when tapped — the app runs on HashRouter, so the sent link
# is "<WEB_APP_URL>/#/notifications".
#
# Optional: falls back to the first CORS_ORIGINS entry, which is the web client
# by definition. Set it explicitly once CORS_ORIGINS lists more than one origin,
# otherwise a push may open whichever happens to be first.
# WEB_APP_URL="https://lopay.netlify.app"

# ── Observability (optional; inert when unset) ──────────────────────────────
# Sentry error tracking + operational alerts (e.g. stalled confirmations).
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0
# Shared secret for GET /metrics: the scraper sends `Authorization: Bearer <token>`
# (or `X-Metrics-Token`). Unset -> open locally, 404 in production. REQUIRED in
# production if you actually scrape: /metrics publishes payment volume and
# confirmation latency, so it must not be world-readable.
METRICS_TOKEN=""

# ── Redis (optional; multi-instance) ────────────────────────────────────────
# When set, backs the Socket.IO adapter, the rate limiters, and the cache so
# they hold across instances. Unset -> in-process fallbacks (fine single-node).
# Local Docker: redis://localhost:6379
REDIS_URL=""

# ── Admin seed (optional) ───────────────────────────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-min-8-chars"

# ── Deployment posture (security switches) ──────────────────────────────────
# These deliberately do NOT read NODE_ENV. The Render deploy runs
# NODE_ENV=development on purpose (the config schema demands a live Paystack key
# and a 64-hex ENCRYPTION_KEY once it is "production"), so gating security on it
# left a public host serving Swagger with no HSTS and no CSP. HSTS, the API CSP
# and the SameSite=None session cookie now follow BETTER_AUTH_URL being https;
# the two below are explicit. See src/common/security-posture.ts.
#
# Serve Swagger UI at /api and the OpenAPI document at /api-json. Defaults to
# OFF so a missing value closes the door. Set to "true" for local development.
API_DOCS_ENABLED="true"
# Header carrying the true client IP at this deployment's edge — the key both
# auth rate limiters bucket on. Unset -> the socket address, which behind a proxy
# is ONE shared bucket for every caller on the internet (the bug this replaced).
# Only name a header your edge OVERWRITES; one it merely appends to is spoofable
# by the caller. On a Cloudflare-fronted host that is "cf-connecting-ip".
# To confirm before setting it: deploy, then watch the `clientIp` field in the
# request log. Varying public addresses = correct. One constant address = wrong.
CLIENT_IP_HEADER=""
