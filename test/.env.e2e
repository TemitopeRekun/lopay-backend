# Database for the end-to-end suites. Loaded by test/require-local-database.ts
# BEFORE Nest's ConfigModule runs, so it takes precedence over the developer's
# `.env` — which on this project has held a deployed Supabase URL, and which
# these destructive suites would otherwise happily truncate.
#
# Not a secret: these are the throwaway local credentials from
# docker-compose.yml. Committed on purpose, so a fresh clone can run
# `docker compose up -d postgres && npm run test:e2e` with no further setup.
#
# Exporting DATABASE_URL in the real environment still overrides this — but the
# guard then refuses anything that is not a loopback host.
# `lopay_test`, not `lopaydb`: the suites truncate what they create, and the
# docker init script provisions this second database precisely so that cannot
# reach a developer's seeded dev data.
DATABASE_URL=postgresql://lopay:lopay@localhost:5434/lopay_test?schema=public
