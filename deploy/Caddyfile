# Caddy fetches and renews a Let's Encrypt TLS certificate for API_DOMAIN
# automatically — no certbot, no cron. Requirements:
#   1. A DNS A record for API_DOMAIN pointing at the VM's public IP.
#   2. Ports 80 and 443 open (Oracle security list + the VM firewall).
#
# API_DOMAIN and ACME_EMAIL are injected from deploy/.env by docker-compose.

{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3001
}
