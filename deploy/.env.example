# ============================================================================
# LoPay backend — PRODUCTION env for the Oracle VM Docker stack.
# Copy this file to `.env` (same folder) and fill every value:  cp .env.example .env
#
# NOTE: docker-compose already sets DATABASE_URL, REDIS_URL, DATABASE_SSL,
# TRUST_PROXY and NODE_ENV for the app — do NOT set them here. You only fill in
# the database credentials, the domain, and the app secrets below.
# ============================================================================

# ── Postgres (used by compose to create the DB and build DATABASE_URL) ───────
# Pick a strong password. Generate one: openssl rand -base64 24
POSTGRES_USER=lopay
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=lopaydb

# ── Public domain + TLS (used by Caddy for auto-HTTPS) ───────────────────────
# A DNS A record for API_DOMAIN must point at the VM's public IP before you boot.
API_DOMAIN=api.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# ── Auth: Better Auth ────────────────────────────────────────────────────────
# Secret must be >= 32 chars. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_min_32_char_secret
# Must be the PUBLIC https URL of this API (same host as API_DOMAIN).
BETTER_AUTH_URL=https://api.yourdomain.com
# Google OAuth (optional — leave blank until you wire Google sign-in).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=

# ── Encryption (PII at rest) — REQUIRED in production ────────────────────────
# Exactly 64 hex chars (32 bytes). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: if you lose or change this, previously-encrypted PII cannot be read.
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars

# ── Firebase Admin SDK (receipt storage + FCM push; NOT auth) ────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# One line, keep the literal \n sequences exactly as they appear in the JSON key.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# Optional tuning:
# FIREBASE_SIGNED_URL_TTL_SECONDS=600
# FIREBASE_MAX_UPLOAD_BYTES=5242880

# ── Paystack (split payments) — LIVE key REQUIRED in production ───────────────
# Must be your Paystack LIVE secret key (starts with sk_live_).
PAYSTACK_SECRET_KEY=REPLACE_WITH_YOUR_PAYSTACK_LIVE_KEY
# Leave empty to rely on signature verification (recommended behind a proxy).
PAYSTACK_WEBHOOK_ALLOWED_IPS=
# Where Paystack redirects after payment (your frontend), optional.
PAYSTACK_CALLBACK_URL=https://app.yourdomain.com/payment-complete

# ── CORS — REQUIRED in production ────────────────────────────────────────────
# Comma-separated allowlist of frontend origins that may call this API.
CORS_ORIGINS=https://app.yourdomain.com

# ── Observability (optional) ─────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ── Admin seed (optional) ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-min-8-chars
