  "info": {
    "title": "LoPay API",
    "description": "The LoPay API documentation for frontend integration",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UpdateProfileDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {}
      },
      "CreateClassFeeDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateSchoolDto": {
        "type": "object",
        "properties": {}
      },
      "ConfirmPaymentDto": {
        "type": "object",
        "properties": {}
      },
      "MarkDefaultedDto": {
        "type": "object",
        "properties": {}
      },
      "ReversePaymentDto": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "example": "payment-uuid"
          },
          "reason": {
            "type": "string",
            "example": "Confirmed in error — funds not actually received.",
            "description": "Why the confirmation is being reversed (stored in the audit log)."
          }
        },
        "required": [
          "paymentId"
        ]
      },
      "CreateSchoolDto": {
        "type": "object",
        "properties": {}
      },
      "RegisterDeviceTokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "FCM device token"
          },
          "platform": {
            "type": "string",
            "enum": [
              "web",
              "android",
              "ios"
            ]
          }
        },
        "required": [
          "token",
          "platform"
        ]
      },
      "UnregisterDeviceTokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "FCM device token to unregister"
          }
        },
        "required": [
          "token"
        ]
      },
      "CreateReceiptUploadDto": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "example": "receipt.jpg",
            "description": "Original file name"
          },
          "contentType": {
            "type": "string",
            "example": "image/jpeg",
            "description": "MIME type of the file"
          }
        },
        "required": [
          "fileName"
        ]
      },
      "CreateReceiptDownloadDto": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "example": "payment-uuid"
          }
        },
        "required": [
          "paymentId"
        ]
      },
      "CreateEnrollmentDto": {
        "type": "object",
        "properties": {
          "childId": {
            "type": "string",
            "example": "child-uuid",
            "description": "ID of existing child"
          },
          "childName": {
            "type": "string",
            "example": "Little Timmy",
            "description": "Name of new child (if childId is not provided)"
          },
          "schoolId": {
            "type": "string",
            "example": "school-uuid"
          },
          "className": {
            "type": "string",
            "example": "Grade 1"
          },
          "installmentFrequency": {
            "type": "string",
            "enum": [
              "WEEKLY",
              "MONTHLY"
            ],
            "example": "MONTHLY"
          },
          "firstPaymentPaid": {
            "type": "number",
            "example": 5000,
            "description": "Amount paid for the first payment"
          },
          "termStartDate": {
            "format": "date-time",
            "type": "string",
            "example": "2023-09-01T00:00:00Z"
          },
          "termEndDate": {
            "format": "date-time",
            "type": "string",
            "example": "2023-12-01T00:00:00Z"
          },
          "receiptUrl": {
            "type": "string",
            "example": "receipts/user-uuid/uuid_receipt.jpg",
            "description": "Receipt storage path returned by POST /documents/receipts/upload-url"
          },
          "idempotencyKey": {
            "type": "string",
            "example": "b3f1c2a4-9d8e-4f6a-8c2b-1e2d3f4a5b6c",
            "description": "Client-generated unique key that makes this submission idempotent. Retries with the same key return the original result instead of creating a duplicate payment."
          }
        },
        "required": [
          "schoolId",
          "className",
          "installmentFrequency",
          "firstPaymentPaid",
          "termStartDate",
          "termEndDate"
        ]
      },
      "CreateInstallmentDto": {
        "type": "object",
        "properties": {
          "enrollmentId": {
            "type": "string",
            "example": "enrollment-uuid"
          },
          "amountPaid": {
            "type": "number",
            "example": 2000,
            "description": "Amount being paid"
          },
          "receiptUrl": {
            "type": "string",
            "example": "receipts/user-uuid/uuid_receipt.jpg",
            "description": "Receipt storage path returned by POST /documents/receipts/upload-url"
          },
          "idempotencyKey": {
            "type": "string",
            "example": "b3f1c2a4-9d8e-4f6a-8c2b-1e2d3f4a5b6c",
            "description": "Client-generated unique key that makes this submission idempotent. Retries with the same key return the original result instead of creating a duplicate payment."
          }
        },
        "required": [
          "enrollmentId",
          "amountPaid"
        ]
      },
      "ConfirmEnrollmentDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
