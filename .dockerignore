# Keep the build context small and never ship host artifacts or secrets.
# `npm ci` rebuilds node_modules inside the image; the host copy is often the
# wrong architecture anyway (Windows/x64 vs the arm64 VM).
node_modules
dist
coverage
.git
.github
.vscode

# Secrets — never bake these into an image.
.env
.env.*
!.env.example

# Local-only infra + deploy tooling (not needed to build the app image).
docker-compose.yml
docker
deploy

# Logs / misc
*.log
.DS_Store
