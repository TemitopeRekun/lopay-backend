// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum UserRole {
  SUPER_ADMIN
  SCHOOL_OWNER
  PARENT
}

enum PaymentStatus {
  PENDING
  ACTIVE
  COMPLETED
  DEFAULTED
  FAILED
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum AuditAction {
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
  PAYMENT_REVERSED
  FIRST_PAYMENT_CONFIRMED
  FIRST_PAYMENT_SETTLED
  FIRST_PAYMENT_REJECTED
  FIRST_PAYMENT_PAID
  ENROLLMENT_DEFAULTED
  PAYMENT_DISPUTED
  // Enrollment invites — onboarding parents who paid the school before Lopay.
  ENROLLMENT_INVITE_CREATED
  ENROLLMENT_INVITE_REVOKED
  ENROLLMENT_INVITE_DISPUTED
  ENROLLMENT_INVITE_CLAIMED
  ENROLLMENT_INVITE_RELEASED
  MIGRATED_PAYMENT_AMENDED
}

enum PaymentType {
  FIRST_PAYMENT
  INSTALLMENT
  /// Money a parent paid the school directly BEFORE the school adopted Lopay,
  /// recorded once when they claim an enrollment invite. It is not an
  /// installment: it takes the place of the deposit, so the derived installment
  /// schedule (see common/installment-schedule.ts) opens from the balance it
  /// leaves behind. No money moves through Lopay for it — the school already
  /// holds it — so `receiver` is SCHOOL and `platformAmount` is zero.
  MIGRATED_PAYMENT
}

/// Lifecycle of an enrollment invite. Only PENDING and DISPUTED are "live":
/// a live invite holds the (school, student, class) slot and can still be
/// claimed or revoked. CLAIMED is terminal-successful; REVOKED and EXPIRED are
/// terminal-dead and free the slot for a re-issue.
enum EnrollmentInviteStatus {
  PENDING
  DISPUTED
  CLAIMED
  REVOKED
  EXPIRED
}

enum PaymentReceiver {
  PLATFORM
  SCHOOL
}

enum InstallmentFrequency {
  WEEKLY
  MONTHLY
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  fullName  String?   // domain display name; kept in sync with Better Auth `name`
  role      UserRole

  // Better Auth core user fields
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  phoneNumber   String?   // captured at sign-up; mirrored onto Parent. ENCRYPTED at rest (randomized AES-GCM) — not queryable, not uniquable.
  // Blind index over `phoneNumber`: HMAC-SHA256 of the canonical +234 form, keyed
  // by a subkey of ENCRYPTION_KEY. This — NOT phoneNumber — is what enforces one
  // account per phone number and what "is this number taken?" queries match on,
  // because the randomized ciphertext in phoneNumber can do neither. Nullable so
  // rows predating the column stay valid until backfilled (Postgres allows many
  // NULLs under a unique index). See src/common/phone.ts.
  phoneHash     String?   @unique

  deletedAt DateTime?

  school    School?  @relation
  parent    Parent?
  notifications Notification[]
  deviceTokens  DeviceToken[]

  invitesCreated  EnrollmentInvite[] @relation("EnrollmentInviteCreatedBy")
  invitesClaimed  EnrollmentInvite[] @relation("EnrollmentInviteClaimedBy")
  invitesRevoked  EnrollmentInvite[] @relation("EnrollmentInviteRevokedBy")

  // Better Auth relations
  sessions  Session[]
  accounts  Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@index([role]) // admin user listings filter by role (M4)
}

// ─── Better Auth tables ──────────────────────────────────────────────────────
// Managed by Better Auth (email/password + Google). Field names must match
// Better Auth's expectations exactly.

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String    // "credential" for email/password, "google" for OAuth
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // email/password hash (Better Auth managed)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // One row per (provider, provider-side account). Better Auth looks an account up
  // by exactly this pair on every social sign-in and only inserts when the lookup
  // misses, so without the constraint two concurrent Google callbacks can both miss
  // and both insert — leaving a duplicate link that later reads resolve
  // arbitrarily. Also the pair that must be unique for "is this Google identity
  // already attached to someone else?" to be answerable at all.
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model School {
  id            String   @id @default(uuid())

  // Identity
  name          String
  email         String
  phone         String
  address       String

  // Ownership
  ownerId       String   @unique
  owner         User     @relation(fields: [ownerId], references: [id])

  // Bank / Settlement Info
  bankName      String
  bankCode      String?  // Paystack settlement bank code (e.g. "058"); required for subaccount
  accountName   String
  accountNumber String

  // Paystack split settlement
  paystackSubaccountCode    String?  @unique // e.g. "ACCT_xxxxxxxxxx"
  paystackSubaccountActive  Boolean  @default(false)

  deletedAt     DateTime?

  // Relations
  classes       ClassFee[]
  students      ChildEnrollment[]
  payments      Payment[]
  invites       EnrollmentInvite[]

  createdAt     DateTime @default(now())

  @@index([deletedAt])
  @@index([name]) // school search/ordering by name (M4)
}

model ClassFee {
  id         String  @id @default(uuid())
  schoolId   String
  className  String
  feeAmount  Int
  isActive   Boolean @default(true)

  school     School  @relation(fields: [schoolId], references: [id])

  createdAt  DateTime @default(now())

  @@unique([schoolId, className])
}

model Parent {
  id          String   @id @default(uuid())
  userId      String   @unique
  phoneNumber String

  user        User     @relation(fields: [userId], references: [id])
  children    Child[]

  createdAt   DateTime @default(now())
}

model Child {
  id         String   @id @default(uuid())
  parentId   String
  fullName   String
  className  String

  parent     Parent   @relation(fields: [parentId], references: [id])
  enrollment ChildEnrollment?

  createdAt  DateTime @default(now())

  // A parent cannot have two children with the same name in the same class —
  // this is always a duplicate (double-tap / retry), never a real second child.
  // Guards against duplicate Child rows races; child creation reuses the existing
  // row on conflict (see EnrollmentService.resolveEnrollmentTarget).
  @@unique([parentId, fullName, className])
}


model Payment {
  id              String           @id @default(uuid())
  enrollmentId    String
  schoolId        String

  idempotencyKey  String?          @unique // Client-generated key; prevents duplicate submissions on retry

  amountPaid      Int              // What parent paid
  platformAmount  Int              // Fixed 2.5% platform fee
  schoolAmount    Int              // Amount going to school (parent payment minus platform fee)

  receiver        PaymentReceiver  // School or platform

  paymentType     PaymentType
  status          PaymentTransactionStatus @default(PENDING)
  isConfirmed     Boolean          @default(false)
  paymentDate     DateTime         @default(now())
  receiptUrl      String?

  // Paystack (first-payment split). Null for manual installment payments.
  paystackReference  String?       @unique // Our generated transaction reference
  paystackAccessCode String?       // Returned by initialize; used by the inline popup
  amountCharged      Int?          // Gross amount parent paid (deposit + platform fee + paystack fee)
  paystackFee        Int?          // Estimated Paystack fee at initiation (baked into transactionCharge)
  actualPaystackFee  Int?          // Authoritative fee from charge.success/verify; delta vs estimate is the platform book/bank drift
  transactionCharge  Int?          // Flat amount routed to platform main account (platformFee + estimated paystackFee)

  enrollment      ChildEnrollment  @relation(fields: [enrollmentId], references: [id])
  school          School           @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([schoolId, isConfirmed, status])
  @@index([enrollmentId])
  // M4 scale indexes:
  @@index([paymentDate]) // global transaction ordering + 6-month revenue series
  @@index([status, paystackReference, paymentDate]) // paystack reconciliation sweep
  @@index([paymentType, receiver, isConfirmed, status]) // admin pending/transaction filters
}

model ChildEnrollment {
  id                    String   @id @default(uuid())
  childId               String   @unique
  schoolId              String

  className             String

  totalSchoolFee        Int      // Snapshot of class fee at enrollment
  platformFee           Int      // 2.5% of totalSchoolFee, fixed
  schoolMinimumFee      Int      // 25% of totalSchoolFee

  firstPaymentPaid      Int      // Amount parent actually paid for first payment
  remainingBalance      Int      // Remaining balance after first payment & installments

  paymentStatus         PaymentStatus

  installmentFrequency  InstallmentFrequency
  termStartDate         DateTime
  termEndDate           DateTime

  /// Set only on a plan created by claiming an enrollment invite. Unique, so one
  /// invite can never mint two enrollments even if two claims race.
  enrollmentInviteId    String?  @unique
  enrollmentInvite      EnrollmentInvite? @relation(fields: [enrollmentInviteId], references: [id])

  child                 Child    @relation(fields: [childId], references: [id])
  school                School   @relation(fields: [schoolId], references: [id])
  payments              Payment[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, paymentStatus])
}

/// A school's record of a student whose parent paid fees BEFORE the school
/// adopted Lopay, held until that parent claims it.
///
/// ## Why a staging table rather than a real enrollment
///
/// `ChildEnrollment` hangs off `Child → Parent → User`, and `User.email` /
/// `User.phoneHash` are globally unique. Pre-creating parents as real `User`
/// rows to hold their history would burn those uniqueness slots and collide
/// with `signup-guard.ts` the moment the parent signs up for themselves. The
/// invite therefore carries the facts, and the enrollment graph is built once,
/// at claim time, by `LedgerService.recordMigratedEnrollment`.
///
/// ## How a claim is authorised
///
/// By the raw invite token, and nothing else: 32 random bytes, of which only the
/// SHA-256 digest is stored, so a database dump cannot be replayed into a claim.
///
/// A phone match was required once and was removed. It read as a second factor
/// and was not one — Lopay verifies no phone number anywhere, so a match only
/// proved someone had typed that number into a signup form — while it reliably
/// refused legitimate parents, most sharply when the school mistyped a digit and
/// the wrong number became the only one able to claim.
///
/// The link is a bearer credential and is treated as one: it is sent inside a
/// conversation the school and family have already had, the comparison survives
/// as `claimantPhoneMatched` for the school to see, and a claim that reached the
/// wrong person is undone with `EnrollmentInvitesService.release`.
model EnrollmentInvite {
  id                    String   @id @default(uuid())
  schoolId              String
  createdByUserId       String

  studentName           String
  className             String

  /// Snapshot of the school's published `ClassFee` at issue time, in kobo. Held
  /// on the invite so a later fee change cannot silently restate what the parent
  /// already agreed to on the claim screen.
  totalSchoolFee        Int
  /// Kobo the school says this parent has already paid, off-platform.
  amountAlreadyPaid     Int

  /// The parent's number. Named `phoneNumber` deliberately: the field-name-keyed
  /// PII extension in `common/pii-crypto.ts` encrypts it at rest and decrypts it
  /// on read, with no per-model code.
  phoneNumber           String
  /// Blind index over the same number (`common/phone.ts`). Randomised ciphertext
  /// is not comparable, so this — not `phoneNumber` — is what a claimant's own
  /// number is compared against. That comparison is a SIGNAL for the school, not
  /// a gate on the claim; see `claimantPhoneMatched`.
  parentPhoneHash       String

  installmentFrequency  InstallmentFrequency
  /// Anchor for the derived installment schedule. Deliberately the handover date
  /// rather than the historical term start: anchoring to a term that began months
  /// ago would open the plan already in arrears (see common/arrears.ts).
  planStartDate         DateTime
  termEndDate           DateTime

  /// SHA-256 of the raw token. Unique, so a claim is a single indexed lookup
  /// rather than a scan-and-compare.
  tokenHash             String   @unique
  expiresAt             DateTime

  status                EnrollmentInviteStatus @default(PENDING)

  disputeReason         String?
  disputedAt            DateTime?

  revokedAt             DateTime?
  revokedByUserId       String?

  claimedByUserId       String?
  claimedAt             DateTime?

  /// Whether the claimant's own phone matched `parentPhoneHash`, recorded at the
  /// moment of the claim.
  ///
  /// A SIGNAL, never a gate. Claiming is authorised by holding the link and
  /// nothing else: the link follows a conversation the school and parent have
  /// already had, and a phone match proved almost nothing anyway because Lopay
  /// does not verify phone numbers — it only proves someone typed that number
  /// into a signup form. What it did reliably do was block legitimate parents:
  /// anyone who signed in with Google (no number at all), anyone using a second
  /// phone, and — worst — every case where the school mistyped a digit, which
  /// locked the real parent out of their own child's plan while doing nothing to
  /// stop anyone else.
  ///
  /// So the comparison is kept and the refusal is not. It is STORED rather than
  /// recomputed on read because it is a fact about an instant: a claimant who
  /// later corrects their profile number would otherwise turn retroactively
  /// green, erasing the only trace that anything looked odd.
  ///
  /// Null means not claimed, or claimed before this column existed.
  claimantPhoneMatched  Boolean?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  school                School   @relation(fields: [schoolId], references: [id])
  createdBy             User     @relation("EnrollmentInviteCreatedBy", fields: [createdByUserId], references: [id])
  claimedBy             User?    @relation("EnrollmentInviteClaimedBy", fields: [claimedByUserId], references: [id])
  revokedBy             User?    @relation("EnrollmentInviteRevokedBy", fields: [revokedByUserId], references: [id])
  enrollment            ChildEnrollment?

  /// The school's own list: filter by status, newest first.
  @@index([schoolId, status, createdAt])
  /// "Which invites are waiting for the number I just signed up with?" — lets a
  /// parent be shown their pending invite without holding the link.
  @@index([parentPhoneHash, status])
  /// Drives the expiry sweep, which scans only live invites already past due.
  @@index([status, expiresAt])
}

model PlatformSetting {
  id        String @id @default(uuid())
  key       String @unique
  value     String
}

/// Leader-election lock for scheduled jobs, so a job runs on only ONE instance
/// when horizontally scaled (a row is claimed only if absent or its lock has
/// expired). Connection-independent, unlike pg advisory locks over a pool.
model SchedulerLock {
  name     String   @id
  lockedAt DateTime
}

/// Persistent, replayable log of inbound provider webhooks. Written BEFORE
/// processing (signature already verified) so a transient processing failure
/// past the provider's retry window can be replayed, and duplicate deliveries
/// are deduped via `dedupeKey`.
model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String    // e.g. "paystack"
  eventType   String    // e.g. "charge.success"
  dedupeKey   String    @unique // `${eventType}:${data.id ?? reference}`
  reference   String?
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([reference])
  @@index([provider, eventType])
  @@index([processedAt])
}

/// What kind of notification this is. Drives the recipient's filter tabs, so it
/// must be persisted rather than guessed from the title: a platform broadcast and
/// a payment confirmation are indistinguishable by wording alone.
enum NotificationType {
  /// A money event on the recipient's own enrollment (paid / confirmed / rejected).
  PAYMENT
  /// Something needing attention that is not itself a payment (defaulted, dispute).
  ALERT
  /// A platform-wide announcement broadcast to every parent.
  ANNOUNCEMENT
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           // Who receives this notification (parent or school owner)
  title       String
  message     String
  type        NotificationType @default(PAYMENT)
  isRead      Boolean          @default(false)
  link        String?          // Optional: frontend route to redirect
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, isRead])
}

/// Device tokens for Firebase Cloud Messaging push notifications.
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   // "web", "android", "ios"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Append-only audit trail for money-state-changing actions. Rows are written
/// inside the same transaction as the change they describe and are never
/// updated or deleted.
model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  entityType  String // e.g. "Payment", "ChildEnrollment"
  entityId    String
  actorUserId String? // null for system/scheduler actions
  actorRole   String?
  schoolId    String?
  reason      String?
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([schoolId])
  @@index([createdAt])
}